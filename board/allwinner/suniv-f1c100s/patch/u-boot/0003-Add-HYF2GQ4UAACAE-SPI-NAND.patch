From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shirogane Tsumugi <artoriapendragon123@gmail.com>
Date: Tue, 28 Jul 2026 00:00:00 +0800
Subject: [PATCH] mtd: spinand: add support for HeYangTek HYF2GQ4UAACAE

The HeYangTek HYF2GQ4UAACAE is a 2 Gbit (256 MiB) SLC SPI-NAND with
2048 + 128 byte pages and on-die 14-bit / 512-byte ECC; its JEDEC ID is
c9 52. Unlike the already supported 1 Gbit HYF1GQ4UDACAE, each 512-byte
user data chunk gets a 32-byte spare section (8 meta + 24 ECC parity
bytes), so it needs its own OOB layout. The coarse 2-bit ECC status
decoding is shared with the 1 Gbit part.

Also add the chip to the sunxi SPL's hard-coded SPI-NAND detector so the
SPL does not fall back to the SPI-NOR read path.

Datasheet: HY SPI 2G v2.7 (HYF2GQ4UAACAE / HYF2GQ4UADCAE)
---
 arch/arm/mach-sunxi/spl_spi_sunxi.c |  4 ++
 drivers/mtd/nand/spi/heyangtek.c    | 50 ++++++++++++++++++++++++++++
 2 files changed, 54 insertions(+)

diff --git a/arch/arm/mach-sunxi/spl_spi_sunxi.c b/arch/arm/mach-sunxi/spl_spi_sunxi.c
--- a/arch/arm/mach-sunxi/spl_spi_sunxi.c
+++ b/arch/arm/mach-sunxi/spl_spi_sunxi.c
@@ -371,6 +371,10 @@
 			printf("SPI-NAND: HeYangTek HYF1GQ4UDACAE\n");
 			type = FLASHTYPE_NAND;
 		}
+		else if (!memcmp(chipid, "\xc9\x52", 2)) {
+			printf("SPI-NAND: HeYangTek HYF2GQ4UAACAE\n");
+			type = FLASHTYPE_NAND;
+		}
 		else if (!memcmp(chipid, "\xef\xaa", 2)) {
 			printf("SPI-NAND: Winbond W25N01G\n");
 			type = FLASHTYPE_NAND;
diff --git a/drivers/mtd/nand/spi/heyangtek.c b/drivers/mtd/nand/spi/heyangtek.c
--- a/drivers/mtd/nand/spi/heyangtek.c
+++ b/drivers/mtd/nand/spi/heyangtek.c
@@ -16,6 +16,7 @@
 
 #define SPINAND_MFR_HEYANGTEK		0xc9
 #define HYF1GQ4_DEVICE_ID		0x21
+#define HYF2GQ4_DEVICE_ID		0x52
 
 #define HYF1GQ4_STATUS_ECC_LIMIT_BITFLIPS	(3 << 4)
 
@@ -76,6 +77,46 @@
 	.rfree = hyf1gq4_ooblayout_free,
 };
 
+/*
+ * HYF2GQ4UAACAE has a 128-byte OOB: each 512-byte user data chunk gets a
+ * 32-byte spare section made of 8 meta bytes followed by 24 bytes of on-die
+ * ECC parity (14 bits / 512 bytes).
+ */
+static int hyf2gq4_ooblayout_ecc(struct mtd_info *mtd, int section,
+				 struct mtd_oob_region *region)
+{
+	if (section > 3)
+		return -ERANGE;
+
+	region->offset = (32 * section) + 8;
+	region->length = 24;
+
+	return 0;
+}
+
+static int hyf2gq4_ooblayout_free(struct mtd_info *mtd, int section,
+				  struct mtd_oob_region *region)
+{
+	if (section > 3)
+		return -ERANGE;
+
+	if (section) {
+		region->offset = 32 * section;
+		region->length = 8;
+	} else {
+		/* section 0 has one byte reserved for the bad block marker */
+		region->offset = 1;
+		region->length = 7;
+	}
+
+	return 0;
+}
+
+static const struct mtd_ooblayout_ops hyf2gq4_ooblayout = {
+	.ecc = hyf2gq4_ooblayout_ecc,
+	.rfree = hyf2gq4_ooblayout_free,
+};
+
 static int hyf1gq4_ecc_get_status(struct spinand_device *spinand, u8 status)
 {
 	struct nand_device *nand = spinand_to_nand(spinand);
@@ -120,6 +161,15 @@
 		     SPINAND_HAS_QE_BIT,
 		     SPINAND_ECCINFO(&hyf1gq4_ooblayout,
 				     hyf1gq4_ecc_get_status)),
+	SPINAND_INFO("HYF2GQ4UAACAE", HYF2GQ4_DEVICE_ID,
+		     NAND_MEMORG(1, 2048, 128, 64, 2048, 1, 1, 1),
+		     NAND_ECCREQ(14, 512),
+		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+					      &write_cache_variants,
+					      &update_cache_variants),
+		     SPINAND_HAS_QE_BIT,
+		     SPINAND_ECCINFO(&hyf2gq4_ooblayout,
+				     hyf1gq4_ecc_get_status)),
 };
 
 static int heyangtek_spinand_detect(struct spinand_device *spinand)
-- 
