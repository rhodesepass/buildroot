@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Check Mostima marker at fixed DRAM address.
+ * Sets mstm_ret env var (0 = no marker, 1/2 = type byte) and mstm_flags
+ * (flashing policy bits from header byte 9, 0 when no marker).
+ * Do not use command return code: U-Boot $? is only 0/1.
+ */
+
+#include <common.h>
+#include <command.h>
+#include <env.h>
+#include <mapmem.h>
+
+#define MSTMCHK_ADDR	0x80000000UL
+#define MSTMCHK_MAGIC	0x5f616d6974736f4dULL	/* "Mostima_" */
+
+static int do_mstmchk(struct cmd_tbl *cmdtp, int flag, int argc,
+		      char *const argv[])
+{
+	void *buf;
+	u64 magic;
+	u8 next, flags;
+	char val[8];
+
+	if (argc != 1)
+		return CMD_RET_USAGE;
+
+	env_set("mstm_ret", "0");
+	env_set("mstm_flags", "0");
+
+	buf = map_sysmem(MSTMCHK_ADDR, 10);
+	if (!buf)
+		return CMD_RET_SUCCESS;
+
+	magic = *(u64 *)buf;
+	if (magic != MSTMCHK_MAGIC) {
+		unmap_sysmem(buf);
+		return CMD_RET_SUCCESS;
+	}
+
+	next = *((u8 *)buf + 8);
+	flags = *((u8 *)buf + 9);
+	unmap_sysmem(buf);
+
+	snprintf(val, sizeof(val), "%u", next);
+	env_set("mstm_ret", val);
+
+	/* setexpr parses its operands as hex, so hand it something unambiguous */
+	snprintf(val, sizeof(val), "0x%x", flags);
+	env_set("mstm_flags", val);
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	mstmchk, 1, 0, do_mstmchk,
+	"check Mostima marker at 0x80000000",
+	""
+);
