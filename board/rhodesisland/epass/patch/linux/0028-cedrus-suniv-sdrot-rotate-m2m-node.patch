--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_rotate.c
@@ -0,0 +1,537 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus VPU driver — suniv (VE 0x1663) SDROT rotate node
+ *
+ * 老 IP 的 MPEG 引擎自带 Scale-Down/Rotate 单元,能对 32x32 tiled
+ * NV12(ST12)整帧做 90/180/270 旋转和 H/V 镜像。寄存器序列取自 Tina
+ * libvideoengine.so 的 RotateHw1663;镜像操作码为板上实测。
+ *
+ * 以第二个 m2m video 节点注册,与解码节点共用同一个 m2m_dev,
+ * 由 m2m 框架保证与解码任务在 VE 上串行。普通 QBUF/STREAMON 流程,
+ * 不走 Request API;用标准控制项 V4L2_CID_ROTATE/HFLIP/VFLIP,
+ * 三者归一化成单个硬件操作码(见 cedrus_rotate_update_op)。
+ */
+
+#include <media/v4l2-device.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "cedrus.h"
+#include "cedrus_hw.h"
+#include "cedrus_regs.h"
+
+#define CEDRUS_ROTATE_NAME	"cedrus-rotate"
+
+#define CEDRUS_ROTATE_MIN_SIZE	16U
+#define CEDRUS_ROTATE_MAX_SIZE	3840U
+
+static inline struct cedrus_ctx *cedrus_rotate_file2ctx(struct file *file)
+{
+	return container_of(file->private_data, struct cedrus_ctx, fh);
+}
+
+/*
+ * 宽高对齐到 16(宏块粒度,决定尺寸寄存器),buffer 布局按解码输出的
+ * ST12 约定:stride 32 对齐,chroma 平面起点在 stride * ALIGN(h, 32),
+ * chroma 平面按整 tile 行(64 行亮度对应 32 行色度)补齐。
+ * 传编码尺寸(非 32 对齐)时 chroma 偏移与解码器写出的一致。
+ */
+static void cedrus_rotate_prepare_format(struct v4l2_pix_format *pix_fmt)
+{
+	unsigned int width = pix_fmt->width;
+	unsigned int height = pix_fmt->height;
+
+	width = clamp(width, CEDRUS_ROTATE_MIN_SIZE, CEDRUS_ROTATE_MAX_SIZE);
+	height = clamp(height, CEDRUS_ROTATE_MIN_SIZE, CEDRUS_ROTATE_MAX_SIZE);
+	width = ALIGN(width, 16);
+	height = ALIGN(height, 16);
+
+	pix_fmt->pixelformat = V4L2_PIX_FMT_SUNXI_TILED_NV12;
+	pix_fmt->field = V4L2_FIELD_NONE;
+	pix_fmt->width = width;
+	pix_fmt->height = height;
+	pix_fmt->bytesperline = ALIGN(width, 32);
+	pix_fmt->sizeimage = pix_fmt->bytesperline * ALIGN(height, 32) +
+			     pix_fmt->bytesperline * ALIGN(height, 64) / 2;
+}
+
+static inline u32 cedrus_rotate_chroma_offset(struct v4l2_pix_format *pix_fmt)
+{
+	return pix_fmt->bytesperline * ALIGN(pix_fmt->height, 32);
+}
+
+/* dec_ops */
+
+static void cedrus_rotate_irq_clear(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, VE_DEC_MPEG_STATUS,
+		     VE_DEC_MPEG_STATUS_ROTATE_CLEAR_MASK);
+}
+
+static void cedrus_rotate_irq_disable(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 reg = cedrus_read(dev, VE_DEC_MPEG_CTRL);
+
+	reg &= ~(VE_DEC_MPEG_CTRL_ROTATE_IRQ_EN |
+		 VE_DEC_MPEG_CTRL_ERROR_IRQ_EN |
+		 VE_DEC_MPEG_CTRL_FINISH_IRQ_EN);
+
+	cedrus_write(dev, VE_DEC_MPEG_CTRL, reg);
+}
+
+static enum cedrus_irq_status cedrus_rotate_irq_status(struct cedrus_ctx *ctx)
+{
+	u32 reg = cedrus_read(ctx->dev, VE_DEC_MPEG_STATUS);
+
+	if (reg & VE_DEC_MPEG_STATUS_ERROR)
+		return CEDRUS_IRQ_ERROR;
+
+	if (reg & VE_DEC_MPEG_STATUS_ROTATE_SUCCESS)
+		return CEDRUS_IRQ_OK;
+
+	return CEDRUS_IRQ_NONE;
+}
+
+static void cedrus_rotate_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct v4l2_pix_format *src_fmt = &ctx->src_fmt;
+	struct v4l2_pix_format *dst_fmt = &ctx->dst_fmt;
+	dma_addr_t src_luma =
+		vb2_dma_contig_plane_dma_addr(&run->src->vb2_buf, 0);
+	dma_addr_t dst_luma =
+		vb2_dma_contig_plane_dma_addr(&run->dst->vb2_buf, 0);
+
+	cedrus_engine_enable(dev, CEDRUS_CODEC_ROTATE);
+
+	cedrus_write(dev, VE_DEC_MPEG_SDROT_SIZE,
+		     VE_DEC_MPEG_SDROT_SIZE_MB(src_fmt->width,
+					       src_fmt->height));
+
+	cedrus_write(dev, VE_DEC_MPEG_REC_LUMA, src_luma);
+	cedrus_write(dev, VE_DEC_MPEG_REC_CHROMA,
+		     src_luma + cedrus_rotate_chroma_offset(src_fmt));
+	cedrus_write(dev, VE_DEC_MPEG_ROT_LUMA, dst_luma);
+	cedrus_write(dev, VE_DEC_MPEG_ROT_CHROMA,
+		     dst_luma + cedrus_rotate_chroma_offset(dst_fmt));
+
+	cedrus_write(dev, VE_DEC_MPEG_SDROT_CTRL, ctx->codec.rotate.op);
+
+	cedrus_write(dev, VE_DEC_MPEG_CTRL,
+		     VE_DEC_MPEG_CTRL_ROTATE_SCALE_OUT_EN |
+		     VE_DEC_MPEG_CTRL_ROTATE_IRQ_EN |
+		     VE_DEC_MPEG_CTRL_ERROR_IRQ_EN |
+		     VE_DEC_MPEG_CTRL_FINISH_IRQ_EN);
+
+	cedrus_rotate_irq_clear(ctx);
+}
+
+static void cedrus_rotate_trigger(struct cedrus_ctx *ctx)
+{
+	/* 高字节 0x05 照抄 blob 的字节写序列,含义未知,勿省 */
+	cedrus_write(ctx->dev, VE_DEC_MPEG_TRIGGER,
+		     (0x05 << 24) | VE_DEC_MPEG_TRIGGER_HW_ROTATE);
+}
+
+struct cedrus_dec_ops cedrus_dec_ops_rotate = {
+	.irq_clear	= cedrus_rotate_irq_clear,
+	.irq_disable	= cedrus_rotate_irq_disable,
+	.irq_status	= cedrus_rotate_irq_status,
+	.setup		= cedrus_rotate_setup,
+	.trigger	= cedrus_rotate_trigger,
+};
+
+/* 控制项 */
+
+/*
+ * angle/hflip/vflip 归一化成 SDROT_CTRL[2:0] 单操作码:
+ * 双镜像 = 180° 旋转;单镜像与 180° 复合等于另一种单镜像
+ * (180° = H∘V,与镜像可交换);单镜像与 90°/270° 复合对应
+ * op 6/7,硬件未验证,拒绝。
+ */
+static int cedrus_rotate_update_op(struct cedrus_ctx *ctx,
+				   unsigned int angle, bool hflip, bool vflip)
+{
+	if ((hflip != vflip) && (angle == 90 || angle == 270))
+		return -EINVAL;
+
+	ctx->codec.rotate.angle = angle;
+	ctx->codec.rotate.hflip = hflip;
+	ctx->codec.rotate.vflip = vflip;
+
+	if (hflip && vflip) {
+		angle = (angle + 180) % 360;
+		hflip = vflip = false;
+	}
+	if (hflip != vflip) {
+		if (angle == 180) {
+			hflip = !hflip;
+			vflip = !vflip;
+		}
+		ctx->codec.rotate.op = hflip ?
+			VE_DEC_MPEG_SDROT_CTRL_OP_HMIRROR :
+			VE_DEC_MPEG_SDROT_CTRL_OP_VMIRROR;
+	} else {
+		ctx->codec.rotate.op = VE_DEC_MPEG_SDROT_CTRL_OP_ANGLE(angle);
+	}
+
+	return 0;
+}
+
+static int cedrus_rotate_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cedrus_ctx *ctx =
+		container_of(ctrl->handler, struct cedrus_ctx, hdl);
+	unsigned int angle = ctx->codec.rotate.angle;
+	bool hflip = ctx->codec.rotate.hflip;
+	bool vflip = ctx->codec.rotate.vflip;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ROTATE:
+		angle = ctrl->val;
+		break;
+	case V4L2_CID_HFLIP:
+		hflip = ctrl->val;
+		break;
+	case V4L2_CID_VFLIP:
+		vflip = ctrl->val;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return cedrus_rotate_update_op(ctx, angle, hflip, vflip);
+}
+
+static const struct v4l2_ctrl_ops cedrus_rotate_ctrl_ops = {
+	.s_ctrl		= cedrus_rotate_s_ctrl,
+};
+
+/* ioctl */
+
+static int cedrus_rotate_querycap(struct file *file, void *priv,
+				  struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, CEDRUS_NAME, sizeof(cap->driver));
+	strscpy(cap->card, CEDRUS_ROTATE_NAME, sizeof(cap->card));
+	snprintf(cap->bus_info, sizeof(cap->bus_info),
+		 "platform:%s", CEDRUS_NAME);
+
+	return 0;
+}
+
+static int cedrus_rotate_enum_fmt(struct file *file, void *priv,
+				  struct v4l2_fmtdesc *f)
+{
+	if (f->index != 0)
+		return -EINVAL;
+
+	f->pixelformat = V4L2_PIX_FMT_SUNXI_TILED_NV12;
+
+	return 0;
+}
+
+static int cedrus_rotate_g_fmt_vid_cap(struct file *file, void *priv,
+				       struct v4l2_format *f)
+{
+	f->fmt.pix = cedrus_rotate_file2ctx(file)->dst_fmt;
+
+	return 0;
+}
+
+static int cedrus_rotate_g_fmt_vid_out(struct file *file, void *priv,
+				       struct v4l2_format *f)
+{
+	f->fmt.pix = cedrus_rotate_file2ctx(file)->src_fmt;
+
+	return 0;
+}
+
+static int cedrus_rotate_try_fmt(struct file *file, void *priv,
+				 struct v4l2_format *f)
+{
+	cedrus_rotate_prepare_format(&f->fmt.pix);
+
+	return 0;
+}
+
+static int cedrus_rotate_s_fmt(struct file *file, void *priv,
+			       struct v4l2_format *f)
+{
+	struct cedrus_ctx *ctx = cedrus_rotate_file2ctx(file);
+	struct vb2_queue *vq;
+
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, f->type);
+	if (vb2_is_busy(vq))
+		return -EBUSY;
+
+	cedrus_rotate_prepare_format(&f->fmt.pix);
+
+	if (V4L2_TYPE_IS_OUTPUT(f->type))
+		ctx->src_fmt = f->fmt.pix;
+	else
+		ctx->dst_fmt = f->fmt.pix;
+
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops cedrus_rotate_ioctl_ops = {
+	.vidioc_querycap		= cedrus_rotate_querycap,
+
+	.vidioc_enum_fmt_vid_cap	= cedrus_rotate_enum_fmt,
+	.vidioc_g_fmt_vid_cap		= cedrus_rotate_g_fmt_vid_cap,
+	.vidioc_try_fmt_vid_cap		= cedrus_rotate_try_fmt,
+	.vidioc_s_fmt_vid_cap		= cedrus_rotate_s_fmt,
+
+	.vidioc_enum_fmt_vid_out	= cedrus_rotate_enum_fmt,
+	.vidioc_g_fmt_vid_out		= cedrus_rotate_g_fmt_vid_out,
+	.vidioc_try_fmt_vid_out		= cedrus_rotate_try_fmt,
+	.vidioc_s_fmt_vid_out		= cedrus_rotate_s_fmt,
+
+	.vidioc_reqbufs			= v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf		= v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf			= v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf			= v4l2_m2m_ioctl_dqbuf,
+	.vidioc_prepare_buf		= v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_create_bufs		= v4l2_m2m_ioctl_create_bufs,
+	.vidioc_expbuf			= v4l2_m2m_ioctl_expbuf,
+
+	.vidioc_streamon		= v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff		= v4l2_m2m_ioctl_streamoff,
+};
+
+/* vb2 */
+
+static int cedrus_rotate_queue_setup(struct vb2_queue *vq,
+				     unsigned int *nbufs,
+				     unsigned int *nplanes,
+				     unsigned int sizes[],
+				     struct device *alloc_devs[])
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vq);
+	struct v4l2_pix_format *pix_fmt;
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type))
+		pix_fmt = &ctx->src_fmt;
+	else
+		pix_fmt = &ctx->dst_fmt;
+
+	if (!pix_fmt->sizeimage)
+		return -EINVAL;
+
+	if (*nplanes) {
+		if (sizes[0] < pix_fmt->sizeimage)
+			return -EINVAL;
+	} else {
+		sizes[0] = pix_fmt->sizeimage;
+		*nplanes = 1;
+	}
+
+	return 0;
+}
+
+static int cedrus_rotate_buf_prepare(struct vb2_buffer *vb)
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct v4l2_pix_format *pix_fmt;
+
+	if (V4L2_TYPE_IS_OUTPUT(vb->vb2_queue->type))
+		pix_fmt = &ctx->src_fmt;
+	else
+		pix_fmt = &ctx->dst_fmt;
+
+	if (vb2_plane_size(vb, 0) < pix_fmt->sizeimage)
+		return -EINVAL;
+
+	vb2_set_plane_payload(vb, 0, pix_fmt->sizeimage);
+
+	return 0;
+}
+
+static int cedrus_rotate_buf_out_validate(struct vb2_buffer *vb)
+{
+	to_vb2_v4l2_buffer(vb)->field = V4L2_FIELD_NONE;
+
+	return 0;
+}
+
+static void cedrus_rotate_buf_queue(struct vb2_buffer *vb)
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, to_vb2_v4l2_buffer(vb));
+}
+
+static void cedrus_rotate_stop_streaming(struct vb2_queue *vq)
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vq);
+	struct vb2_v4l2_buffer *vbuf;
+
+	for (;;) {
+		if (V4L2_TYPE_IS_OUTPUT(vq->type))
+			vbuf = v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx);
+		else
+			vbuf = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+
+		if (!vbuf)
+			return;
+
+		v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_ERROR);
+	}
+}
+
+static struct vb2_ops cedrus_rotate_qops = {
+	.queue_setup		= cedrus_rotate_queue_setup,
+	.buf_prepare		= cedrus_rotate_buf_prepare,
+	.buf_queue		= cedrus_rotate_buf_queue,
+	.buf_out_validate	= cedrus_rotate_buf_out_validate,
+	.stop_streaming		= cedrus_rotate_stop_streaming,
+	.wait_prepare		= vb2_ops_wait_prepare,
+	.wait_finish		= vb2_ops_wait_finish,
+};
+
+static int cedrus_rotate_queue_init(void *priv, struct vb2_queue *src_vq,
+				    struct vb2_queue *dst_vq)
+{
+	struct cedrus_ctx *ctx = priv;
+	int ret;
+
+	src_vq->type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+	src_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	src_vq->drv_priv = ctx;
+	src_vq->buf_struct_size = sizeof(struct cedrus_buffer);
+	src_vq->min_buffers_needed = 1;
+	src_vq->ops = &cedrus_rotate_qops;
+	src_vq->mem_ops = &vb2_dma_contig_memops;
+	src_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src_vq->lock = &ctx->dev->dev_mutex;
+	src_vq->dev = ctx->dev->dev;
+
+	ret = vb2_queue_init(src_vq);
+	if (ret)
+		return ret;
+
+	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	dst_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst_vq->drv_priv = ctx;
+	dst_vq->buf_struct_size = sizeof(struct cedrus_buffer);
+	dst_vq->min_buffers_needed = 1;
+	dst_vq->ops = &cedrus_rotate_qops;
+	dst_vq->mem_ops = &vb2_dma_contig_memops;
+	dst_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst_vq->lock = &ctx->dev->dev_mutex;
+	dst_vq->dev = ctx->dev->dev;
+
+	return vb2_queue_init(dst_vq);
+}
+
+/* 文件操作与注册 */
+
+static int cedrus_rotate_open(struct file *file)
+{
+	struct cedrus_dev *dev = video_drvdata(file);
+	struct cedrus_ctx *ctx;
+	int ret;
+
+	if (mutex_lock_interruptible(&dev->dev_mutex))
+		return -ERESTARTSYS;
+
+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (!ctx) {
+		mutex_unlock(&dev->dev_mutex);
+		return -ENOMEM;
+	}
+
+	v4l2_fh_init(&ctx->fh, video_devdata(file));
+	file->private_data = &ctx->fh;
+	ctx->dev = dev;
+	ctx->current_codec = CEDRUS_CODEC_ROTATE;
+
+	v4l2_ctrl_handler_init(&ctx->hdl, 3);
+	v4l2_ctrl_new_std(&ctx->hdl, &cedrus_rotate_ctrl_ops,
+			  V4L2_CID_ROTATE, 0, 270, 90, 0);
+	v4l2_ctrl_new_std(&ctx->hdl, &cedrus_rotate_ctrl_ops,
+			  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	v4l2_ctrl_new_std(&ctx->hdl, &cedrus_rotate_ctrl_ops,
+			  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (ctx->hdl.error) {
+		ret = ctx->hdl.error;
+		goto err_free;
+	}
+
+	ctx->fh.ctrl_handler = &ctx->hdl;
+	v4l2_ctrl_handler_setup(&ctx->hdl);
+
+	cedrus_rotate_prepare_format(&ctx->src_fmt);
+	cedrus_rotate_prepare_format(&ctx->dst_fmt);
+
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(dev->m2m_dev, ctx,
+					    &cedrus_rotate_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		goto err_ctrls;
+	}
+
+	v4l2_fh_add(&ctx->fh);
+
+	mutex_unlock(&dev->dev_mutex);
+
+	return 0;
+
+err_ctrls:
+	v4l2_ctrl_handler_free(&ctx->hdl);
+err_free:
+	kfree(ctx);
+	mutex_unlock(&dev->dev_mutex);
+
+	return ret;
+}
+
+static const struct v4l2_file_operations cedrus_rotate_fops = {
+	.owner		= THIS_MODULE,
+	.open		= cedrus_rotate_open,
+	.release	= cedrus_release,
+	.poll		= v4l2_m2m_fop_poll,
+	.unlocked_ioctl	= video_ioctl2,
+	.mmap		= v4l2_m2m_fop_mmap,
+};
+
+static const struct video_device cedrus_rotate_video_device = {
+	.name		= CEDRUS_ROTATE_NAME,
+	.vfl_dir	= VFL_DIR_M2M,
+	.fops		= &cedrus_rotate_fops,
+	.ioctl_ops	= &cedrus_rotate_ioctl_ops,
+	.minor		= -1,
+	.release	= video_device_release_empty,
+	.device_caps	= V4L2_CAP_VIDEO_M2M | V4L2_CAP_STREAMING,
+};
+
+int cedrus_rotate_register(struct cedrus_dev *dev)
+{
+	struct video_device *vfd = &dev->vfd_rotate;
+	int ret;
+
+	*vfd = cedrus_rotate_video_device;
+	vfd->lock = &dev->dev_mutex;
+	vfd->v4l2_dev = &dev->v4l2_dev;
+	video_set_drvdata(vfd, dev);
+
+	ret = video_register_device(vfd, VFL_TYPE_GRABBER, -1);
+	if (ret) {
+		v4l2_err(&dev->v4l2_dev,
+			 "Failed to register rotate video device\n");
+		return ret;
+	}
+
+	v4l2_info(&dev->v4l2_dev,
+		  "Rotate device registered as /dev/video%d\n", vfd->num);
+
+	return 0;
+}
+
+void cedrus_rotate_unregister(struct cedrus_dev *dev)
+{
+	video_unregister_device(&dev->vfd_rotate);
+}
