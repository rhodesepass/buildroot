#!/bin/sh
#
# SD 启动拔卡 watcher。由 S02sdwatch 复制到 /tmp 并用 /tmp/busybox sh 运行。
# 拔卡后 rootfs(SD p2) 上的文件不可靠(page cache 可能已被回收):
#   - fork+exec 只允许指向 /tmp/busybox 与 /tmp/sderror(都在 tmpfs)
#   - kill/test/read/echo/重定向是 ash builtin, 不产生 exec
# ash 对非 builtin 命令会重新 open 二进制(未开 FEATURE_PREFER_APPLETS),
# 所以 sleep/killall/pidof 都必须显式走 $BB

BB=/tmp/busybox

# 趁 rootfs 活着缓存 supervise 的 PID
read APP_PID < /var/run/epass_app.pid 2> /dev/null

# 卡移除时内核撤掉整个 block 设备, sysfs 目录消失; 纯内存操作零 IO
while test -d /sys/block/mmcblk0; do
    $BB sleep 1
done

echo "sdwatch: SD removed, rootfs dead" > /dev/kmsg

# 先杀 supervise 防止它 respawn app, 再杀 app 本体
kill "$APP_PID" 2> /dev/null
$BB killall app_360 app_720 system_maintenance quick_start 2> /dev/null

# 等 app 退出释放 DRM master(sderror 自带重试, 这里只是加速)
n=0
while [ -n "$($BB pidof app_360 app_720)" ] && [ $n -lt 30 ]; do
    $BB sleep 0.1
    n=$((n + 1))
done
$BB killall -9 app_360 app_720 2> /dev/null

# 替换自身, 前台驻留持有 DRM fd 常显 SD ERROR
exec /tmp/sderror
