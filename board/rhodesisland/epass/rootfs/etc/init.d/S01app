#!/bin/sh
#
# epass app supervisor
#
# app exit code protocol:
#   0 - clean exit, stop supervising
#   1 - remount SD card, restart app
#   2 - run staged /tmp/appstart (self update), restart app
#   3 - power off
#   4 - launch system_maintenance (SD format UI), then remount + restart app
#   5 - mount boot partition + srgn_config, restart app
#   * - crash (incl. 128+N killed by signal), auto restart

APP_DIR=/root
PIDFILE=/var/run/epass_app.pid
SYSTEM_MAINTENANCE=/app/system_maintenance/system_maintenance
QUICK_START=/app/quick_start/quick_start
QUICK_START_DONE=/etc/.quick_start_done

log() {
    echo "epass_app: $*" > /dev/kmsg
}

# 不能读 /sys/class/drm/card0-*/modes:FBDEV_EMULATION 关了,app 自己
# 打开 DRM 之前没人 probe connector,modes 恒为空
panel_mode() {
    tr '\0' '\n' < /proc/device-tree/panel/compatible 2>/dev/null | head -n 1
}

pick_app() {
    case "$(panel_mode)" in
        lattland,hsd-nv3052) echo "$APP_DIR/app_720" ;;
        sargon,papyrus)      echo "$APP_DIR/app_720" ;;
        *)                   echo "$APP_DIR/app_360" ;;
    esac
}

# 挂载逻辑收进 /usr/sbin/sdmount(与 mdev 热插拔共用, flock 串行化);
# app 自己按 /proc/mounts 判断 /sd 是否可用，不再传参
remount_sd() {
    /usr/sbin/sdmount remount > /dev/null 2>&1
}

supervise() {
    cd "$APP_DIR" || exit 1

    APP=$(pick_app)
    log "panel mode '$(panel_mode)', using $APP"

    if [ ! -f "$APP" ]; then
        log "$APP missing, switching to MTP"
        usbaioctl select mtp || usbctl mtp
        exit 1
    fi

    remount_sd

    # 收掉 U-Boot splash：DRM 可能仍在异步 probe，最多等 5 秒再启动应用。
    # release 会先停 DEBE layer，等待扫描排空，再把保留显存还给 buddy。
    if ls /proc/device-tree/reserved-memory/splash-fb@*/compatible > /dev/null 2>&1; then
        splash_wait=0
        while [ ! -w /sys/kernel/srgn_splash/release ] && [ "$splash_wait" -lt 100 ]; do
            sleep 0.05
            splash_wait=$((splash_wait + 1))
        done
        if [ -w /sys/kernel/srgn_splash/release ]; then
            echo 1 > /sys/kernel/srgn_splash/release
        else
            log "splash handover release interface timed out"
        fi
    fi

    # 首次开机：SD 已挂载、splash 已释放，再跑 quick_start，之后才进主 app
    if [ ! -f "$QUICK_START_DONE" ]; then
        if [ -x "$QUICK_START" ]; then
            log "first boot: starting $QUICK_START"
            "$QUICK_START"
            log "quick_start finished (exit $?)"
        else
            log "first boot: $QUICK_START missing, skip"
        fi
        touch "$QUICK_START_DONE"
    fi

    while true; do
        # 不能无条件 chmod: overlayfs 上对 lower 文件 setattr 会整文件
        # copy-up 进 upper, 之后刷 lower 就更新不到这个 app 了
        [ -x "$APP" ] || chmod +x "$APP" 2> /dev/null
        log "starting $APP"
        "$APP" > /dev/null 2>&1
        ret=$?
        case "$ret" in
            0)
                log "clean exit"
                break
                ;;
            1)
                remount_sd
                ;;
            2)
                log "running /tmp/appstart"
                chmod +x /tmp/appstart 2> /dev/null
                /tmp/appstart
                ;;
            3)
                log "poweroff requested"
                poweroff
                break
                ;;
            4)
                if [ -x "$SYSTEM_MAINTENANCE" ]; then
                    log "starting $SYSTEM_MAINTENANCE"
                    "$SYSTEM_MAINTENANCE"
                else
                    log "$SYSTEM_MAINTENANCE missing"
                fi
                remount_sd
                ;;
            5)
                mount_boot
                command -v srgn_config > /dev/null && srgn_config
                ;;
            *)
                log "app crashed (exit $ret), restarting"
                sleep 2
                ;;
        esac
    done
    rm -f "$PIDFILE"
}

case "$1" in
    start)
        supervise &
        echo $! > "$PIDFILE"
        ;;
    stop)
        [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2> /dev/null
        rm -f "$PIDFILE"
        killall app_360 app_720 system_maintenance quick_start 2> /dev/null
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
