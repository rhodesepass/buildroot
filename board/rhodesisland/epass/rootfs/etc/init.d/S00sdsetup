#!/bin/sh
#
# SD 启动首次开机初始化
#   - rootfs 容器(p2)在线扩容 ext4 到整个分区
#   - share 分区(mmcblk0p4)扩容:
#     xfel 路径由 U-Boot sdflash 按卡实际容量写 MBR,天然正确;
#     dd 整卡镜像(sd_image.img)里 p4 的 size 写的是"到 2TB 上限",
#     内核解析时会截断到卡的实际末尾,这里把盘上 MBR 的 size 字段
#     改成实际值,让分区表在读卡器上看也是自洽的
#   - share 分区还没有文件系统时格式化成 FAT
# (data 分区 p3 由 preinit 负责,不在本脚本范围)
# 三步都是幂等的,非首次开机时基本无开销。

DISK=/dev/mmcblk0
ROOT_DEV=/dev/mmcblk0p2
SHARE_DEV=/dev/mmcblk0p4
# MBR 第 4 个分区表项的 size 字段偏移: 446 + 3*16 + 12
SHARE_SIZE_OFF=506

log() {
    echo "sdsetup: $*" > /dev/kmsg
}

fix_share_size() {
    total=$(cat /sys/block/mmcblk0/size 2> /dev/null)
    start=$(cat /sys/block/mmcblk0/mmcblk0p4/start 2> /dev/null)
    runtime=$(cat /sys/block/mmcblk0/mmcblk0p4/size 2> /dev/null)
    [ -n "$total" ] && [ -n "$start" ] && [ -n "$runtime" ] || return

    desired=$((total - start))
    ondisk=$(hexdump -s $SHARE_SIZE_OFF -n 4 -e '1/4 "%u"' "$DISK" 2> /dev/null)
    [ "$ondisk" = "$desired" ] && return

    # 内核运行时大小应已被截断成 desired;若不是,说明不是
    # "镜像 p4 写到上限被截断" 这种情况,不要乱动分区表
    if [ "$runtime" != "$desired" ]; then
        log "share size mismatch (disk=$ondisk runtime=$runtime want=$desired), MBR untouched"
        return
    fi

    log "fixing share partition size in MBR: $ondisk -> $desired sectors"
    printf "\\x$(printf %02x $((desired & 255)))\\x$(printf %02x $(((desired >> 8) & 255)))\\x$(printf %02x $(((desired >> 16) & 255)))\\x$(printf %02x $(((desired >> 24) & 255)))" \
        | dd of="$DISK" bs=1 seek=$SHARE_SIZE_OFF count=4 conv=notrunc 2> /dev/null \
        && sync \
        || log "MBR patch failed"
}

case "$1" in
    start | restart | reload) ;;
    stop)
        exit 0
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

# 仅 SD 启动的系统需要处理
grep -q "root=$ROOT_DEV" /proc/cmdline || exit 0

# rootfs 在线扩容到分区大小(已是全尺寸时 resize2fs 为空操作)
if command -v resize2fs > /dev/null 2>&1; then
    out=$(resize2fs "$ROOT_DEV" 2>&1) || log "resize2fs failed: $out"
else
    log "resize2fs not found, rootfs not grown"
fi

# share 分区: 先修正 MBR 里的大小,
# 再在没有文件系统时格成 FAT(busybox mkfs.vfat 按大小自动选 FAT16/32)
# 注意: 未开 CONFIG_FEATURE_BLKID_TYPE 时 busybox blkid 不打印 TYPE=,
# 但仍会打印 LABEL=/UUID=,不能只靠 TYPE= 判断
if [ -b "$SHARE_DEV" ]; then
    fix_share_size
    if ! blkid "$SHARE_DEV" 2> /dev/null | grep -qE 'TYPE=|UUID=|LABEL='; then
        log "formatting $SHARE_DEV as FAT"
        mkfs.vfat -n SHARE "$SHARE_DEV" > /dev/null 2>&1 || log "mkfs.vfat $SHARE_DEV failed"
    fi
else
    log "$SHARE_DEV not present, skip share partition setup"
fi
