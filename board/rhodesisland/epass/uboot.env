kernaddr=0x80008000
dtbaddr=0x80C00000
dtboaddr=0x80D00000
envtxtaddr=0x80E00000
fitaddr=0x81000000
fbaddr=0x81800000
mstmpayload=0x80000010

enterdfu=setenv dfu_alt_info "uboot part 1;boot part 3;rootfs partubi 4"; \
    dfu 0 mtd spi-nand0; \
    sleep 1; \
    dfu 0 mtd spi-nand0; \
    sleep 1; \
    dfu 0 mtd spi-nand0;

enterdfu_sd=setenv dfu_alt_info "uboot raw 0x10 0x7f0;boot part 0 1;rootfs part 0 2"; \
    dfu 0 mmc 0; \
    sleep 1; \
    dfu 0 mmc 0; \
    sleep 1; \
    dfu 0 mmc 0;

rundfu=mtd erase spi-nand0 0x100000 0x7E00000; \
    run enterdfu; \
    run distro_bootcmd;

load1env_nand=mtd read spi-nand0 ${envtxtaddr} 0xE0000 0x6000; \
    env import -t ${envtxtaddr}

load1env_sd=if load mmc 0:1 ${envtxtaddr} env.txt; then \
        env import -t ${envtxtaddr} ${filesize}; setenv bootdev sd; \
    else run load1env_nand; setenv bootdev nand; fi

load1env_select=if test "${boot_device}" = "spi"; then \
        run load1env_nand; setenv bootdev nand; \
    else \
        if test "${boot_device}" = "mmc0"; then \
            run load1env_sd; \
        else \
            if mmc dev 0; then run load1env_sd; \
            else run load1env_nand; setenv bootdev nand; fi; \
        fi; \
    fi

loadenvfromddr=setexpr.l mstm_envlen *0x8000000c; \
    if itest ${mstm_envlen} -gt 0x6000; then \
        echo mstm env too large; \
    else \
        cp.b ${mstmpayload} ${envtxtaddr} ${mstm_envlen}; \
        mtd erase spi-nand0 0xE0000 0x20000; \
        mtd write spi-nand0 ${envtxtaddr} 0xE0000 0x6000; \
        env import -t ${envtxtaddr}; \
    fi

loadenvfromddr_sd=setexpr.l mstm_envlen *0x8000000c; \
    if itest ${mstm_envlen} -gt 0x6000; then \
        echo mstm env too large; \
    else \
        cp.b ${mstmpayload} ${envtxtaddr} ${mstm_envlen}; \
        env import -t ${envtxtaddr}; \
    fi

sdflash=run loadenvfromddr_sd; \
    mmc dev 0; \
    setenv mbr_parts 'name=boot,start=1M,size=8M,bootable,id=0x0e;name=rootfs,size=128M,id=0x83;name=share,size=-,id=0x0c'; \
    mbr write mmc 0; \
    run enterdfu_sd; \
    mmc dev 0; \
    setexpr mstm_fatlen ${mstm_envlen} - 1; \
    fatwrite mmc 0:1 ${envtxtaddr} env.txt ${mstm_fatlen}; \
    mw.l 0x80000000 0; mw.l 0x80000004 0; \
    reset

load1env=mstmchk; \
    if itest ${mstm_ret} -eq 1; then \
        run loadenvfromddr; \
        mw.l 0x80000000 0; mw.l 0x80000004 0; \
        run rundfu; \
    fi; \
    if itest ${mstm_ret} -eq 2; then run sdflash; fi; \
    if itest ${mstm_ret} -eq 0; then run load1env_select; fi

checkdtbsfit=mtd read spi-nand0 $fitaddr 0x100000 0x800; \
    if fdt addr $fitaddr; then \
        fdt header get dtbsfitsize totalsize; \
        if itest $dtbsfitsize -gt 0x100000; then setenv dtbsfitsize 0; fi; \
    else \
        setenv dtbsfitsize 0; \
    fi

loaddtbsfit=run checkdtbsfit; \
    if itest $dtbsfitsize -eq 0; then \
        echo "DTBs FIT header invalid, going DFU"; run rundfu; \
    fi; \
    mtd read spi-nand0 $fitaddr 0x100000 $dtbsfitsize; \
    if fdt addr $fitaddr; then \
        true; \
    else \
        echo "DTBs FIT not valid after read, going DFU"; run rundfu; \
    fi

loaddtbsfit_sd=setenv dtbsfitsize 0; \
    if load mmc 0:1 ${fitaddr} dtbs.itb; then \
        if fdt addr ${fitaddr}; then \
            fdt header get dtbsfitsize totalsize; \
            if itest ${dtbsfitsize} -gt 0x100000; then setenv dtbsfitsize 0; fi; \
        fi; \
    fi; \
    if itest ${dtbsfitsize} -eq 0; then \
        echo "SD DTBs FIT invalid, going SD DFU"; run enterdfu_sd; \
    fi

checkkernelfit=setenv kernelfitscan 0x200000; \
    setenv kernelfitoff 0; \
    setenv kernelfitsize 0; \
    while itest ${kernelfitscan} -lt 0x700000; do \
        mtd read spi-nand0 ${fitaddr} ${kernelfitscan} 0x800; \
        if fdt addr ${fitaddr}; then \
            fdt header get kernelfitsize totalsize; \
            if itest ${kernelfitsize} -gt 0x500000; then \
                setenv kernelfitsize 0; \
                setexpr kernelfitscan ${kernelfitscan} + 0x20000; \
            else \
                setenv kernelfitoff ${kernelfitscan}; \
                setenv kernelfitscan 0x700000; \
            fi; \
        else \
            setexpr kernelfitscan ${kernelfitscan} + 0x20000; \
        fi; \
    done; \
    if itest ${kernelfitsize} -ne 0; then \
        echo "Kernel FIT found at physical offset ${kernelfitoff}"; \
    fi

loadkernelfit=run checkkernelfit; \
    if itest $kernelfitsize -eq 0; then \
        echo "Kernel FIT header invalid, going DFU"; run rundfu; \
    fi; \
    mtd read spi-nand0 $fitaddr $kernelfitoff $kernelfitsize; \
    if fdt addr $fitaddr; then \
        true; \
    else \
        echo "Kernel FIT not valid after read, going DFU"; run rundfu; \
    fi

loadkernelfit_sd=setenv kernelfitsize 0; \
    if load mmc 0:1 ${fitaddr} kernel.itb; then \
        if fdt addr ${fitaddr}; then \
            fdt header get kernelfitsize totalsize; \
            if itest ${kernelfitsize} -gt 0x500000; then setenv kernelfitsize 0; fi; \
        fi; \
    fi; \
    if itest ${kernelfitsize} -eq 0; then \
        echo "SD Kernel FIT invalid, going SD DFU"; run enterdfu_sd; \
    fi

loaddtbs=run loaddtbsfit; \
    imxtract $fitaddr fdt-base-${device_rev} $dtbaddr; \
    imxtract $fitaddr fdt-screen-${screen} $dtboaddr;

loaddtbs_sd=run loaddtbsfit_sd; \
    imxtract $fitaddr fdt-base-${device_rev} $dtbaddr; \
    imxtract $fitaddr fdt-screen-${screen} $dtboaddr;

loadkernel=run loadkernelfit; \
    imxtract $fitaddr kernel $kernaddr;

loadkernel_sd=run loadkernelfit_sd; \
    imxtract $fitaddr kernel $kernaddr;

patchbasic=fdt addr $dtbaddr; fdt resize 32768; fdt apply $dtboaddr;
patchinterface=for ov in ${interface}; do echo Applying Interface ${ov}...; imxtract $fitaddr fdt-iface-${ov} $dtboaddr; fdt apply $dtboaddr; done;
patchext=for ov in ${ext}; do echo Applying extension ${ov}...; imxtract $fitaddr fdt-ext-${ov} $dtboaddr; fdt apply $dtboaddr; done;

panelinit=srgn_st7701init ${dtbaddr};

splash=if imxtract ${fitaddr} logo-${screen} ${fbaddr}; then srgn_splash ${dtbaddr} ${fbaddr}; fi;
splashargs=if test -n "${splash_active}"; then setenv bootargs "${bootargs} clk_ignore_unused"; fi;

ensurecmdline=if test -z "$bootargs"; then setenv bootargs "console=ttyS0,115200 panic=5 rootwait root=ubi0:rootfs earlyprintk rw rootfstype=ubifs ubi.mtd=rootfs ubi.fm_autoconvert=1"; fi
ensurecmdline_sd=if test -z "$bootargs"; then setenv bootargs "console=ttyS0,115200 panic=5 rootwait root=/dev/mmcblk0p2 rw rootfstype=ext4"; fi

quietargs=if chk_verbose_boot ${dtbaddr}; then \
        true; \
    else \
        echo ===========================; \
        echo srgn:default to quiet boot.; \
        echo HOLD KEY_1 for Verbose boot!; \
        echo ===========================; \
        setenv bootargs "${bootargs} quiet"; \
    fi
extraargs=if test -n "${extracmd}"; then setenv bootargs "${bootargs} ${extracmd}"; fi

distro_bootcmd=run load1env; \
    if test "${bootdev}" = "sd"; then run loaddtbs_sd; else run loaddtbs; fi; \
    run patchbasic; run patchinterface; run patchext; \
    init_verbose_key ${dtbaddr}; \
    run panelinit; run splash; \
    if test "${bootdev}" = "sd"; then run loadkernel_sd; run ensurecmdline_sd; else run loadkernel; run ensurecmdline; fi; \
    run quietargs; \
    run splashargs; run extraargs; bootz $kernaddr - $dtbaddr; \
    if test "${bootdev}" = "sd"; then run enterdfu_sd; else run rundfu; fi