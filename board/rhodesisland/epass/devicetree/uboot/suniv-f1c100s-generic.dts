/dts-v1/;
#include "suniv-f1c100s.dtsi"

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Allwinner F1C100s Generic Device";
	compatible = "allwinner,suniv-f1c100s",
		     "allwinner,suniv";

	aliases {
		serial0 = &uart0;
		spi0 = &spi0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&otg_sram {
	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins_a>;
	status = "okay";

	spi-nor@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0>;
		compatible = "winbond,w25q128", "jedec,spi-nor";
		spi-max-frequency = <80000000>;
	};

	spi-nand@1 {
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0>;
		compatible = "spi-nand";
		/*
		 * The CDR2 divider off the 200MHz AHB only yields 100/50/33MHz,
		 * so anything under 100 lands on 50. W25N01GV is good to 104.
		 */
		spi-max-frequency = <100000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x0e0000>;
				read-only;
			};

			partition@e0000 {
				label = "bootenv";
				reg = <0x0e0000 0x020000>;
			};

			partition@100000 {
				label = "boot";
				reg = <0x100000 0x600000>;
			};

			/*
			 * 与 linux 侧 epass_common.dtsi 保持一致:
			 * rootfs(系统) + data(overlay upper) 两个分区,
			 * DFU "rootfs partubi 4" 只重写系统, 刷机保数据
			 */
			partition@700000 {
				label = "rootfs";
				reg = <0x700000 0x1c00000>;
			};

			partition@2300000 {
				label = "data";
				reg = <0x2300000 0x5d00000>;
			};
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins_a>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins_a>;
	status = "okay";
};

&usb_otg {
	status = "okay";
};

&usbphy {
	status = "okay";
};

&mmc0 {
	status = "okay";
	bus-width = <4>;
};

&mmc2 {
	status = "okay";
};
