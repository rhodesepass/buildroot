/dts-v1/;
/ {
    description = "ePass DTBs and splash bundle";
    #address-cells = <1>;
    images {
        fdt-base-0.1 {
            description = "base_0.1";
            data = /incbin/("./dt/base/devicetree-0.1.dtb");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-base-0.2 {
            description = "base_0.2";
            data = /incbin/("./dt/base/devicetree-0.2.dtb");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-base-0.3 {
            description = "base_0.3";
            data = /incbin/("./dt/base/devicetree-0.3.dtb");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-base-0.5 {
            description = "base_0.5";
            data = /incbin/("./dt/base/devicetree-0.5.dtb");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-base-0.6 {
            description = "base_0.6";
            data = /incbin/("./dt/base/devicetree-0.6.dtb");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-base-p0.1 {
            description = "base_p0.1";
            data = /incbin/("./dt/base/devicetree-p0.1.dtb");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };

        /* screens */
        fdt-screen-hsd {
            description = "HSD screen overlay";
            data = /incbin/("./dt/screen/hsd.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-screen-boe {
            description = "BOE screen overlay";
            data = /incbin/("./dt/screen/boe.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-screen-laowu {
            description = "Laowu screen overlay";
            data = /incbin/("./dt/screen/laowu.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-screen-hsd_nv3052 {
            description = "HSD NV3052C screen overlay";
            data = /incbin/("./dt/screen/hsd_nv3052.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-screen-boe_035 {
            description = "BOE 3.5 screen overlay";
            data = /incbin/("./dt/screen/boe_035.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };

        /* interfaces */
        fdt-iface-adc_pa1 {
            description = "ADC PA1 interface overlay";
            data = /incbin/("./dt/interface/adc_pa1.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-iface-adc_pa123 {
            description = "ADC PA123 interface overlay";
            data = /incbin/("./dt/interface/adc_pa123.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-iface-i2c0 {
            description = "I2C0 interface overlay";
            data = /incbin/("./dt/interface/i2c0.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-iface-i2s0_pa {
            description = "I2S0 PA interface overlay";
            data = /incbin/("./dt/interface/i2s0_pa.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-iface-i2s0_pe {
            description = "I2S0 PE interface overlay";
            data = /incbin/("./dt/interface/i2s0_pe.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-iface-spi1 {
            description = "SPI1 interface overlay";
            data = /incbin/("./dt/interface/spi1.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-iface-uart1 {
            description = "UART1 interface overlay";
            data = /incbin/("./dt/interface/uart1.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-iface-uart2 {
            description = "UART2 interface overlay";
            data = /incbin/("./dt/interface/uart2.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-iface-usbhost {
            description = "USB host interface overlay";
            data = /incbin/("./dt/interface/usbhost.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-iface-usbhs {
            description = "USB HS interface overlay";
            data = /incbin/("./dt/interface/usbhs.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };

        /* boot splash logos (pre-gzipped RGB565 raw, gunzipped by imxtract) */
        logo-hsd {
            description = "splash logo 360x640 RGB565";
            data = /incbin/("./logo-mostima.rgb565.gz");
            type = "firmware";
            arch = "arm";
            compression = "gzip";
        };
        logo-boe {
            description = "splash logo 360x640 RGB565";
            data = /incbin/("./logo-mostima.rgb565.gz");
            type = "firmware";
            arch = "arm";
            compression = "gzip";
        };
        logo-laowu {
            description = "splash logo 360x640 RGB565";
            data = /incbin/("./logo-mostima.rgb565.gz");
            type = "firmware";
            arch = "arm";
            compression = "gzip";
        };
        logo-hsd_nv3052 {
            description = "splash logo 720x1280 RGB565";
            data = /incbin/("./logo-hsd_nv3052.rgb565.gz");
            type = "firmware";
            arch = "arm";
            compression = "gzip";
        };
        logo-boe_035 {
            description = "splash logo 720x1280 RGB565";
            data = /incbin/("./logo-hsd_nv3052.rgb565.gz");
            type = "firmware";
            arch = "arm";
            compression = "gzip";
        };

        /* exts */
        fdt-ext-cardkb {
            description = "M5Stack CardKB extension overlay";
            data = /incbin/("./dt/ext/cardkb.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-ext-es8311_sound {
            description = "ES8311 sound extension overlay";
            data = /incbin/("./dt/ext/es8311_sound.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-ext-lsm6ds3_pre0.4 {
            description = "LSM6DS3 pre-0.4 extension overlay";
            data = /incbin/("./dt/ext/lsm6ds3_pre0.4.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
        fdt-ext-cvbs {
            description = "TVE CVBS output extension overlay";
            data = /incbin/("./dt/ext/cvbs.dtbo");
            type = "flat_dt";
            arch = "arm";
            compression = "none";
        };
    };
};
